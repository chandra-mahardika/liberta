# Application
APP_NAME=liberta-auth-service
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8080

# Database
DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=liberta_auth
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# JWT
# Generate a strong secret: php -r "echo bin2hex(random_bytes(32));"
JWT_SECRET=CHANGE_ME_GENERATE_WITH_php_r_echo_bin2hex_random_bytes_32_
JWT_ALGORITHM=HS256
JWT_EXPIRY=3600

# Auth Service
AUTH_URL=http://auth-service.internal
# Generate a strong key: php -r "echo bin2hex(random_bytes(32));"
AUTH_KEY=CHANGE_ME_GENERATE_WITH_php_r_echo_bin2hex_random_bytes_32_
